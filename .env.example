PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/innotech_ewaste

# JWT Settings
JWT_ACCESS_SECRET=innotech_super_secret_access_jwt_key_2026
JWT_REFRESH_SECRET=innotech_super_secret_refresh_jwt_key_2026
